<Window x:Class="DesktopNotes.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Perma Notes — Settings" 
        Height="420" Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Background="#F5F5F5">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" Text="Settings" FontSize="20" FontWeight="SemiBold" Foreground="#333"/>

        <!-- Start with Windows -->
        <CheckBox Grid.Row="2" x:Name="StartWithWindowsCheckBox" 
                  Content="Start with Windows" FontSize="14" Margin="0,8"/>

        <!-- Storage Location -->
        <StackPanel Grid.Row="3" Margin="0,8">
            <TextBlock Text="Storage Location:" FontSize="14" Margin="0,0,0,4"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="StoragePathText" Grid.Column="0" IsReadOnly="True" 
                         Height="28" VerticalContentAlignment="Center" Padding="4,0" 
                         Background="#EEE" Foreground="#555" Margin="0,0,8,0"/>
                <Button Grid.Column="1" Content="Browse..." Width="70" Height="28" 
                        Click="BrowseStorage_Click" Cursor="Hand"/>
            </Grid>
        </StackPanel>

        <!-- Confirm before deleting -->
        <CheckBox Grid.Row="4" x:Name="ConfirmDeleteCheckBox" 
                  Content="Confirm before deleting notes" FontSize="14" Margin="0,8"
                  IsChecked="True"/>

        <!-- Default note color -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,12">
            <TextBlock Text="Default note color:" VerticalAlignment="Center" FontSize="14" Margin="0,0,12,0"/>
            <ComboBox x:Name="DefaultColorCombo" Width="130" FontSize="14">
                <ComboBoxItem Content="Yellow" Tag="#FFF9C4" IsSelected="True"/>
                <ComboBoxItem Content="Orange" Tag="#FFE0B2"/>
                <ComboBoxItem Content="Blue" Tag="#90CAF9"/>
                <ComboBoxItem Content="Teal" Tag="#80CBC4"/>
                <ComboBoxItem Content="Green" Tag="#A5D6A7"/>
                <ComboBoxItem Content="Purple" Tag="#CE93D8"/>
                <ComboBoxItem Content="Pink" Tag="#F48FB1"/>
                <ComboBoxItem Content="White" Tag="#FAFAFA"/>
                <ComboBoxItem Content="Gray" Tag="#E0E0E0"/>
            </ComboBox>
        </StackPanel>

        <!-- Default opacity -->
        <StackPanel Grid.Row="6" Margin="0,8">
            <TextBlock FontSize="14" Margin="0,0,0,4">
                <Run Text="Default opacity: "/>
                <Run x:Name="OpacityValueText" Text="100%"/>
            </TextBlock>
            <Slider x:Name="OpacitySlider" Minimum="0.3" Maximum="1.0" Value="1.0"
                    TickFrequency="0.05" IsSnapToTickEnabled="True"
                    ValueChanged="OpacitySlider_ValueChanged"/>
        </StackPanel>

        <!-- Save / Close -->
        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Save" Width="80" Height="32" Margin="0,0,10,0" 
                    Click="SaveButton_Click" FontSize="14"
                    Background="#4CAF50" Foreground="White" BorderThickness="0" Cursor="Hand"/>
            <Button Content="Close" Width="80" Height="32" 
                    Click="CloseButton_Click" FontSize="14"
                    Background="#757575" Foreground="White" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>

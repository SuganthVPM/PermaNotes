<Window x:Class="DesktopNotes.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PermaNotes Settings"
        Height="420" Width="450"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Border Background="#1E1E1E" CornerRadius="12" BorderBrush="#333333" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="15" Opacity="0.5" ShadowDepth="5" />
        </Border.Effect>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title & Close Button -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Settings" FontSize="22" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="✕" Width="30" Height="30" Click="CloseButton_Click"
                        Background="Transparent" Foreground="#AAAAAA" BorderThickness="0" FontSize="16" Cursor="Hand"
                        HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="Close"/>
            </Grid>

            <!-- Start with Windows -->
            <CheckBox Grid.Row="2" x:Name="StartWithWindowsCheckBox"
                      Content="Start PermaNotes when Windows starts" FontSize="14" Foreground="#CCCCCC" Margin="0,8"/>

            <!-- Storage Location -->
            <StackPanel Grid.Row="3" Margin="0,8">
                <TextBlock Text="Storage Location:" FontSize="14" Foreground="#CCCCCC" Margin="0,0,0,6"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="StoragePathText" Grid.Column="0" IsReadOnly="True"
                             Height="32" VerticalContentAlignment="Center" Padding="8,0"
                             Background="#2D2D2D" Foreground="#EEEEEE" BorderBrush="#444444" BorderThickness="1" Margin="0,0,10,0"/>
                    <Button Grid.Column="1" Content="Browse..." Width="80" Height="32"
                            Click="BrowseStorage_Click" Cursor="Hand"
                            Background="#333333" Foreground="White" BorderThickness="0"/>
                </Grid>
            </StackPanel>

            <!-- Confirm before deleting -->
            <CheckBox Grid.Row="4" x:Name="ConfirmDeleteCheckBox"
                      Content="Confirm before deleting notes" FontSize="14" Foreground="#CCCCCC" Margin="0,8"
                      IsChecked="True"/>

            <!-- Default note color -->
            <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,12">
                <TextBlock Text="Default note color:" VerticalAlignment="Center" FontSize="14" Foreground="#CCCCCC" Margin="0,0,15,0"/>
                <ComboBox x:Name="DefaultColorCombo" Width="140" Height="30" FontSize="14" Margin="0,0,10,0"
                          Background="#2D2D2D" Foreground="Black">
                    <ComboBoxItem Content="Yellow" Tag="#FFF9C4" IsSelected="True"/>
                    <ComboBoxItem Content="Orange" Tag="#FFE0B2"/>
                    <ComboBoxItem Content="Blue" Tag="#90CAF9"/>
                    <ComboBoxItem Content="Teal" Tag="#80CBC4"/>
                    <ComboBoxItem Content="Green" Tag="#A5D6A7"/>
                    <ComboBoxItem Content="Purple" Tag="#CE93D8"/>
                    <ComboBoxItem Content="Pink" Tag="#F48FB1"/>
                    <ComboBoxItem Content="White" Tag="#FAFAFA"/>
                    <ComboBoxItem Content="Gray" Tag="#E0E0E0"/>
                </ComboBox>
                <Button x:Name="CustomColorButton" Content="Custom..." Width="70" Height="30"
                        Click="CustomColor_Click" Cursor="Hand" Background="#333333" Foreground="White" BorderThickness="0"/>
            </StackPanel>

            <!-- Default opacity -->
            <StackPanel Grid.Row="6" Margin="0,8">
                <TextBlock FontSize="14" Foreground="#CCCCCC" Margin="0,0,0,6">
                    <Run Text="Default opacity: "/>
                    <Run x:Name="OpacityValueText" Text="100%" FontWeight="Bold" Foreground="#FFFFFF"/>
                </TextBlock>
                <Slider x:Name="OpacitySlider" Minimum="0.3" Maximum="1.0" Value="1.0"
                        TickFrequency="0.05" IsSnapToTickEnabled="True"
                        ValueChanged="OpacitySlider_ValueChanged"
                        Foreground="#007ACC"/>
            </StackPanel>

            <!-- Save / Cancel -->
            <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="Cancel" Width="90" Height="35" Margin="0,0,10,0"
                        Click="CloseButton_Click" FontSize="14"
                        Background="#333333" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                <Button Content="Save" Width="90" Height="35"
                        Click="SaveButton_Click" FontSize="14" FontWeight="SemiBold"
                        Background="#007ACC" Foreground="White" BorderThickness="0" Cursor="Hand"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>

<Window x:Class="DesktopNotes.Views.NoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Perma Note" 
        Height="280" Width="320"
        MinHeight="150" MinWidth="200"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        Loaded="Window_Loaded"
        StateChanged="Window_StateChanged"
        KeyDown="Window_KeyDown"
        ContextMenu="{DynamicResource NoteContextMenu}">

    <Window.Resources>
        <Style TargetType="{x:Type Paragraph}">
            <Setter Property="Margin" Value="0"/>
        </Style>
        <Style TargetType="{x:Type List}">
            <Setter Property="Margin" Value="0"/>
        </Style>

        <!-- Full Context Menu -->
        <ContextMenu x:Key="NoteContextMenu" Opened="ContextMenu_Opened">
            <!-- Context Menu (Reorganized) -->
            <MenuItem Command="ApplicationCommands.Cut" Header="Cut" InputGestureText="Ctrl+X" />
            <MenuItem Command="ApplicationCommands.Copy" Header="Copy" InputGestureText="Ctrl+C" />
            <MenuItem Command="ApplicationCommands.Paste" Header="Paste" InputGestureText="Ctrl+V" />
            <Separator/>
            <MenuItem Header="Format">
                <MenuItem Command="EditingCommands.ToggleBold" Header="Bold" InputGestureText="Ctrl+B" />
                <MenuItem Command="EditingCommands.ToggleItalic" Header="Italic" InputGestureText="Ctrl+I" />
                <MenuItem Command="EditingCommands.ToggleUnderline" Header="Underline" InputGestureText="Ctrl+U" />
                <MenuItem Header="Strikethrough" Click="StrikethroughText_Click" InputGestureText="Ctrl+Shift+X" />
                <Separator/>
                <MenuItem Header="Highlight" Click="HighlightText_Click" InputGestureText="Ctrl+H" />
                <Separator/>
                <MenuItem Header="Font Size">
                    <MenuItem Header="10" Tag="10" Click="FontSizeMenu_Click" />
                    <MenuItem Header="12" Tag="12" Click="FontSizeMenu_Click" />
                    <MenuItem Header="14" Tag="14" Click="FontSizeMenu_Click" />
                    <MenuItem Header="16" Tag="16" Click="FontSizeMenu_Click" />
                    <MenuItem Header="18" Tag="18" Click="FontSizeMenu_Click" />
                    <MenuItem Header="20" Tag="20" Click="FontSizeMenu_Click" />
                    <MenuItem Header="24" Tag="24" Click="FontSizeMenu_Click" />
                    <MenuItem Header="28" Tag="28" Click="FontSizeMenu_Click" />
                    <MenuItem Header="32" Tag="32" Click="FontSizeMenu_Click" />
                </MenuItem>
            </MenuItem>
            <MenuItem Header="Insert">
                <MenuItem Header="Timestamp" Click="InsertTimestamp_Click" InputGestureText="Ctrl+T" />
            </MenuItem>
            <Separator/>
            <MenuItem Header="New Note" Click="NewNoteButton_Click" InputGestureText="Ctrl+N" />
            <MenuItem Header="Duplicate" Click="DuplicateNote_Click"/>
            <Separator/>
            <MenuItem Header="Note Manager" Click="NoteManagerMenu_Click"/>
            <Separator/>
            <MenuItem Header="Export as Text File" Click="ExportNoteAsText_Click"/>
            <Separator/>
            <MenuItem Header="Color">
                <MenuItem Header="Yellow" Click="ColorMenu_Click" Tag="#FFF9C4">
                    <MenuItem.Icon><Rectangle Width="14" Height="14" Fill="#FFF9C4" RadiusX="2" RadiusY="2" Stroke="#80000000" StrokeThickness="0.5"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Orange" Click="ColorMenu_Click" Tag="#FFE0B2">
                    <MenuItem.Icon><Rectangle Width="14" Height="14" Fill="#FFE0B2" RadiusX="2" RadiusY="2" Stroke="#80000000" StrokeThickness="0.5"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Green" Click="ColorMenu_Click" Tag="#A5D6A7">
                    <MenuItem.Icon><Rectangle Width="14" Height="14" Fill="#A5D6A7" RadiusX="2" RadiusY="2" Stroke="#80000000" StrokeThickness="0.5"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Teal" Click="ColorMenu_Click" Tag="#80CBC4">
                    <MenuItem.Icon><Rectangle Width="14" Height="14" Fill="#80CBC4" RadiusX="2" RadiusY="2" Stroke="#80000000" StrokeThickness="0.5"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Blue" Click="ColorMenu_Click" Tag="#90CAF9">
                    <MenuItem.Icon><Rectangle Width="14" Height="14" Fill="#90CAF9" RadiusX="2" RadiusY="2" Stroke="#80000000" StrokeThickness="0.5"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Purple" Click="ColorMenu_Click" Tag="#CE93D8">
                    <MenuItem.Icon><Rectangle Width="14" Height="14" Fill="#CE93D8" RadiusX="2" RadiusY="2" Stroke="#80000000" StrokeThickness="0.5"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Pink" Click="ColorMenu_Click" Tag="#F48FB1">
                    <MenuItem.Icon><Rectangle Width="14" Height="14" Fill="#F48FB1" RadiusX="2" RadiusY="2" Stroke="#80000000" StrokeThickness="0.5"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="White" Click="ColorMenu_Click" Tag="#FAFAFA">
                    <MenuItem.Icon><Rectangle Width="14" Height="14" Fill="#FAFAFA" RadiusX="2" RadiusY="2" Stroke="#80000000" StrokeThickness="0.5"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Gray" Click="ColorMenu_Click" Tag="#E0E0E0">
                    <MenuItem.Icon><Rectangle Width="14" Height="14" Fill="#E0E0E0" RadiusX="2" RadiusY="2" Stroke="#80000000" StrokeThickness="0.5"/></MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Custom Color..." Click="CustomColorMenu_Click"/>
            </MenuItem>
            <MenuItem x:Name="OpacityMenuItem" Header="Opacity">
                <MenuItem Header="100%" Click="OpacityMenu_Click" Tag="1.0" IsCheckable="True"/>
                <MenuItem Header="90%" Click="OpacityMenu_Click" Tag="0.90" IsCheckable="True"/>
                <MenuItem Header="80%" Click="OpacityMenu_Click" Tag="0.80" IsCheckable="True"/>
                <MenuItem Header="70%" Click="OpacityMenu_Click" Tag="0.70" IsCheckable="True"/>
                <MenuItem Header="60%" Click="OpacityMenu_Click" Tag="0.60" IsCheckable="True"/>
                <MenuItem Header="50%" Click="OpacityMenu_Click" Tag="0.50" IsCheckable="True"/>
                <MenuItem Header="40%" Click="OpacityMenu_Click" Tag="0.40" IsCheckable="True"/>
                <MenuItem Header="30%" Click="OpacityMenu_Click" Tag="0.30" IsCheckable="True"/>
            </MenuItem>
            <Separator/>
            <MenuItem x:Name="AlwaysOnTopMenuItem" Header="Always on Top" IsCheckable="True" Click="AlwaysOnTopMenu_Click"/>
            <MenuItem x:Name="LockNoteMenuItem" Header="Lock Note" Click="LockNoteButton_Click" InputGestureText="Ctrl+Shift+L"/>
            <MenuItem x:Name="ClickThroughMenuItem" Header="Enable Click-Through" Click="ClickThroughMenu_Click"/>
            <Separator/>
            <MenuItem Header="Close this Note" Click="CloseNoteMenu_Click"/>
            <MenuItem Header="Delete Note" Click="DeleteNoteButton_Click"/>
            <Separator/>
            <MenuItem Header="Settings" Click="SettingsMenu_Click"/>
            <MenuItem Header="Exit PermaNotes" Click="ExitAppMenu_Click"/>
        </ContextMenu>

        <!-- Sleek ScrollBar Style -->
        <Style x:Key="SleekScrollThumbStyle" TargetType="Thumb">
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbBorder" HorizontalAlignment="Right" Margin="0,0,2,0">
                            <!-- Animation for smooth width expansion -->
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Width" Value="4"/>
                                    <Setter Property="Background" Value="#40000000"/>
                                    <Setter Property="CornerRadius" Value="2"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Thumb}}" Value="True">
                                            <Setter Property="Width" Value="10"/>
                                            <Setter Property="Background" Value="#60000000"/>
                                            <Setter Property="CornerRadius" Value="5"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsDragging, RelativeSource={RelativeSource AncestorType=Thumb}}" Value="True">
                                            <Setter Property="Width" Value="10"/>
                                            <Setter Property="Background" Value="#90000000"/>
                                            <Setter Property="CornerRadius" Value="5"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="true">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SleekScrollThumbStyle}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Header button style (+ ✕ icons) -->
        <Style x:Key="HeaderButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#777777"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#15000000"/>
                                <Setter Property="Foreground" Value="#333333"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style x:Key="FormatToolbarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#55FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <!-- Separate shadow border for hardware acceleration and snappy dragging -->
        <Border Background="{Binding Background, ElementName=CardBorder}" Style="{StaticResource CardBorderStyle}">
            <Border.CacheMode>
                <BitmapCache SnapsToDevicePixels="True"/>
            </Border.CacheMode>
            <Border.Effect>
                <DropShadowEffect x:Name="WindowShadow" BlurRadius="15" ShadowDepth="4" Direction="270" Color="Black" Opacity="0.15" RenderingBias="Performance"/>
            </Border.Effect>
        </Border>

        <Border x:Name="CardBorder" Background="#FFF9C4" BorderBrush="Transparent" Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="36"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header / Drag Bar -->
                <Grid Grid.Row="0" x:Name="HeaderGrid" Background="Transparent" 
                      MouseLeftButtonDown="Header_MouseLeftButtonDown"
                      Margin="4,4,4,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Title: TextBlock by default, TextBox on double-click -->
                    <TextBlock x:Name="TitleBlock" Grid.Column="0" 
                               Margin="12,0,0,0" 
                               VerticalAlignment="Center" 
                               FontFamily="Inter, Roboto, Segoe UI Variable, Segoe UI"
                               FontWeight="SemiBold" 
                               FontSize="14" 
                               Foreground="#444444"
                               TextTrimming="CharacterEllipsis"
                               MouseLeftButtonDown="TitleBlock_MouseLeftButtonDown"/>

                    <TextBox x:Name="TitleEditBox" Grid.Column="0" 
                             Margin="10,2,4,2" 
                             VerticalAlignment="Center" 
                             FontFamily="Inter, Roboto, Segoe UI Variable, Segoe UI"
                             FontWeight="SemiBold" 
                             FontSize="14" 
                             Foreground="#333333" 
                             Background="#30FFFFFF" 
                             BorderThickness="0"
                             Padding="4,2"
                             Visibility="Collapsed"
                             LostFocus="TitleEditBox_LostFocus"
                             KeyDown="TitleEditBox_KeyDown"/>

                    <TextBlock x:Name="SavedIndicator" Grid.Column="1" 
                               Text="Saved" 
                               VerticalAlignment="Center" 
                               FontSize="11" 
                               Foreground="#88333333" 
                               Margin="0,0,8,0"
                               Opacity="0"/>
                    
                    <Button x:Name="ClickThroughBtn" Grid.Column="2" Style="{StaticResource HeaderButtonStyle}" 
                            ToolTip="Enable Click-Through" Click="ClickThroughMenu_Click" Margin="0,0,2,0">
                        <Path Data="M21,3H7C5.89,3,5,3.89,5,5v4H3v12c0,1.1,0.89,2,2,2h12v-2H5V11h14v2h2V5C21,3.89,20.1,3,21,3z M19,9H7V5h12V9z M14,14v8l2.25-2.25l2.5,4.25l1.5-0.75l-2.5-4.25l3.5,0L14,14z" 
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" 
                              Stretch="Uniform" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>

                    <Button x:Name="LockNoteBtn" Grid.Column="3" Style="{StaticResource HeaderButtonStyle}" 
                            ToolTip="Lock Note" Click="LockNoteButton_Click" Margin="0,0,2,0">
                        <Path x:Name="LockIconPath" Data="M 19 9 L 5 9 C 3.9 9 3 9.9 3 11 L 3 20 C 3 21.1 3.9 22 5 22 L 19 22 C 20.1 22 21 21.1 21 20 L 21 11 C 21 9.9 20.1 9 19 9 Z M 10 9 L 10 6 C 10 2.7 7.3 0 4 0 C 0.7 0 -2 2.7 -2 6 L -2 15 C -2 16.1 -0.9 17 0 17 C 0.9 17 2 16.1 2 15 L 2 6 C 2 4.9 2.9 4 4 4 C 5.1 4 6 4.9 6 6 L 6 9 Z M 12 17 A 1.5 1.5 0 0 0 12.75 14.33 L 12.75 12 A 0.75 0.75 0 0 0 11.25 12 L 11.25 14.33 A 1.5 1.5 0 0 0 12 17 Z" 
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" 
                              Stretch="Uniform" Width="13" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>

                    <Button x:Name="NewNoteBtn" Grid.Column="4" Style="{StaticResource HeaderButtonStyle}" 
                            ToolTip="New Note" Click="NewNoteButton_Click" Margin="0,0,2,0">
                        <Path Data="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H10v-2H6V4h7v5h5v3h2V8l-6-6zM18 15v3h-3v2h3v3h2v-3h3v-2h-3v-3h-2z" 
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" 
                              Stretch="Uniform" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>

                    <Button x:Name="SearchNoteBtn" Grid.Column="5" Style="{StaticResource HeaderButtonStyle}" 
                            ToolTip="Search Notes" Click="SearchNoteButton_Click" Margin="0,0,2,0">
                        <Path Data="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H11v-2H6V4h7v5h5v4h2V8l-6-6zM15.5 15c-1.93 0-3.5 1.57-3.5 3.5s1.57 3.5 3.5 3.5c.71 0 1.37-.23 1.9-.61l2.69 2.69 1.41-1.41-2.69-2.69c.38-.53.61-1.19.61-1.9 0-1.93-1.57-3.5-3.5-3.5zm0 5c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5z" 
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" 
                              Stretch="Uniform" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>

                    <Button x:Name="DeleteNoteBtn" Grid.Column="6" Style="{StaticResource HeaderButtonStyle}" 
                            ToolTip="Delete Note" Click="DeleteNoteButton_Click" Margin="0,0,2,0">
                        <Path Data="M 9 3 L 9 4 L 4 4 L 4 6 L 5 6 L 5 20 C 5 21.104569 5.8954305 22 7 22 L 17 22 C 18.104569 22 19 21.104569 19 20 L 19 6 L 20 6 L 20 4 L 15 4 L 15 3 C 15 1.8954305 14.104569 1 13 1 L 11 1 C 9.8954305 1 9 1.8954305 9 3 z M 11 3 L 13 3 L 13 4 L 11 4 L 11 3 z M 7 6 L 17 6 L 17 20 L 7 20 L 7 6 z M 9 8 L 11 8 L 11 18 L 9 18 L 9 8 z M 13 8 L 15 8 L 15 18 L 13 18 L 13 8 z" 
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" 
                              Stretch="Uniform" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>

                    <Button x:Name="CloseNoteBtn" Grid.Column="7" Content="✕" Style="{StaticResource HeaderButtonStyle}" 
                            ToolTip="Close Note" Click="CloseNoteButton_Click" Margin="0,0,6,0"/>
                </Grid>

                <!-- Rich Text Content Editor -->
                <RichTextBox x:Name="ContentRichTextBox" Grid.Row="1" 
                             Margin="16,4,16,16" 
                             AcceptsReturn="True" 
                             AcceptsTab="True" 
                             VerticalScrollBarVisibility="Auto" 
                             ScrollViewer.CanContentScroll="False"
                             Background="Transparent" 
                             BorderThickness="0" 
                             FontSize="15" 
                             Foreground="#333333" 
                             FontFamily="Inter, Roboto, Segoe UI Variable, Segoe UI"
                             Cursor="Arrow"
                             PreviewMouseWheel="ContentRichTextBox_PreviewMouseWheel"
                             PreviewMouseUp="ContentRichTextBox_PreviewMouseUp"
                             PreviewMouseLeftButtonDown="ContentRichTextBox_PreviewMouseLeftButtonDown"
                             PreviewKeyDown="ContentRichTextBox_PreviewKeyDown"
                             SelectionChanged="ContentRichTextBox_SelectionChanged"
                             TextChanged="ContentRichTextBox_TextChanged"
                             IsDocumentEnabled="True"
                             ContextMenu="{DynamicResource NoteContextMenu}">
                </RichTextBox>

                <!-- Custom Resize Grip to prevent DWM crashes -->
                <Thumb Grid.Row="1" Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE" Background="Transparent" DragDelta="ResizeGrip_DragDelta">
                    <Thumb.Template>
                        <ControlTemplate>
                            <Border Background="Transparent"/>
                        </ControlTemplate>
                    </Thumb.Template>
                </Thumb>
            </Grid>
        </Border>

        <!-- Formatting Popup -->
        <Popup x:Name="FormatPopup" AllowsTransparency="True" StaysOpen="False" Placement="MousePoint" HorizontalOffset="-30" VerticalOffset="-40">
            <Border Background="#DD1A1A1A" CornerRadius="8" BorderBrush="#555555" BorderThickness="1" Padding="4">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.4" Direction="270"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource FormatToolbarButtonStyle}" Command="EditingCommands.ToggleBold" CommandTarget="{Binding ElementName=ContentRichTextBox}" ToolTip="Bold">
                        <TextBlock Text="B" FontWeight="Bold" FontSize="14" Foreground="White" Margin="0,0,0,1"/>
                    </Button>
                    <Button Style="{StaticResource FormatToolbarButtonStyle}" Command="EditingCommands.ToggleItalic" CommandTarget="{Binding ElementName=ContentRichTextBox}" ToolTip="Italic">
                        <TextBlock Text="I" FontStyle="Italic" FontSize="14" FontFamily="Georgia" Foreground="White"/>
                    </Button>
                    <Button Style="{StaticResource FormatToolbarButtonStyle}" Command="EditingCommands.ToggleUnderline" CommandTarget="{Binding ElementName=ContentRichTextBox}" ToolTip="Underline">
                        <TextBlock Text="U" TextDecorations="Underline" FontSize="14" Foreground="White" Margin="0,0,0,1"/>
                    </Button>
                    <Button Style="{StaticResource FormatToolbarButtonStyle}" Click="StrikethroughText_Click" ToolTip="Strikethrough (Ctrl+Shift+X)">
                        <TextBlock Text="S" TextDecorations="Strikethrough" FontSize="14" Foreground="White" Margin="0,0,0,1"/>
                    </Button>
                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="2" Background="#444444"/>
                    <Button Style="{StaticResource FormatToolbarButtonStyle}" Click="HighlightText_Click" ToolTip="Highlight (Ctrl+H)">
                        <Path Data="M3 14 L3 17 L6 17 L17.5 5.5 L14.5 2.5 Z M14.5 5.5 L6 14" Fill="White" Stretch="Uniform" Width="12" Height="12"/>
                    </Button>
                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="2" Background="#444444"/>
                    <Button Style="{StaticResource FormatToolbarButtonStyle}" Command="EditingCommands.ToggleBullets" CommandTarget="{Binding ElementName=ContentRichTextBox}" ToolTip="Bullet List">
                        <Path Data="M3 4 A 1.5 1.5 0 1 1 3 7 A 1.5 1.5 0 0 1 3 4 Z M8 5 L18 5 L18 6 L8 6 Z M3 11 A 1.5 1.5 0 1 1 3 14 A 1.5 1.5 0 0 1 3 11 Z M8 12 L18 12 L18 13 L8 13 Z" Fill="White" Stretch="Uniform" Width="12" Height="12"/>
                    </Button>
                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="2" Background="#444444"/>
                    <Button Style="{StaticResource FormatToolbarButtonStyle}" Click="IncreaseFontSize_Click" ToolTip="Increase Font Size">
                        <TextBlock Text="A↑" FontSize="12" Foreground="White"/>
                    </Button>
                    <Button Style="{StaticResource FormatToolbarButtonStyle}" Click="DecreaseFontSize_Click" ToolTip="Decrease Font Size">
                        <TextBlock Text="A↓" FontSize="12" Foreground="White"/>
                    </Button>
                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="2" Background="#444444"/>
                    <Button Style="{StaticResource FormatToolbarButtonStyle}" Command="ApplicationCommands.Undo" CommandTarget="{Binding ElementName=ContentRichTextBox}" ToolTip="Undo (Ctrl+Z)">
                        <TextBlock Text="↶" FontSize="16" Foreground="White" Margin="0,-2,0,0"/>
                    </Button>
                    <Button Style="{StaticResource FormatToolbarButtonStyle}" Command="ApplicationCommands.Redo" CommandTarget="{Binding ElementName=ContentRichTextBox}" ToolTip="Redo (Ctrl+Y)">
                        <TextBlock Text="↷" FontSize="16" Foreground="White" Margin="0,-2,0,0"/>
                    </Button>
                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="2" Background="#444444"/>
                    <Button Style="{StaticResource FormatToolbarButtonStyle}" Click="InsertTimestamp_Click" ToolTip="Insert Timestamp (Ctrl+T)">
                        <TextBlock Text="🕐" FontSize="12" Foreground="White"/>
                    </Button>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>

<Window x:Class="DesktopNotes.Views.NoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Perma Note" 
        Height="280" Width="320"
        MinHeight="150" MinWidth="200"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        Loaded="Window_Loaded"
        StateChanged="Window_StateChanged"
        PreviewKeyDown="Window_PreviewKeyDown"
        ContextMenu="{DynamicResource NoteContextMenu}">

    <Window.Resources>
        <Style TargetType="{x:Type Paragraph}">
            <Setter Property="Margin" Value="0"/>
        </Style>
        <Style TargetType="{x:Type List}">
            <Setter Property="Margin" Value="0"/>
        </Style>

        <!-- Full Context Menu -->
        <ContextMenu x:Key="NoteContextMenu" Opened="ContextMenu_Opened">
            <!-- 1. Text & Clipboard Operations -->
            <MenuItem Command="ApplicationCommands.Cut" Header="Cut" InputGestureText="Ctrl+X" />
            <MenuItem Command="ApplicationCommands.Copy" Header="Copy" InputGestureText="Ctrl+C" />
            <MenuItem Command="ApplicationCommands.Paste" Header="Paste" InputGestureText="Ctrl+V" />
            <Separator/>
            <MenuItem Header="Format">
                <MenuItem Command="EditingCommands.ToggleBold" Header="Bold" InputGestureText="Ctrl+B" />
                <MenuItem Command="EditingCommands.ToggleItalic" Header="Italic" InputGestureText="Ctrl+I" />
                <MenuItem Command="EditingCommands.ToggleUnderline" Header="Underline" InputGestureText="Ctrl+U" />
                <MenuItem Header="Strikethrough" Click="StrikethroughText_Click" InputGestureText="Ctrl+Shift+X" />
                <Separator/>
                <MenuItem Header="Highlight" Click="HighlightText_Click" InputGestureText="Ctrl+H" />
                <MenuItem x:Name="HyperlinksMenuItem" Header="Hyperlinks" IsCheckable="True" Click="ToggleHyperlinks_Click" ToolTip="Automatically format URLs as clickable hyperlinks"/>
                <Separator/>
                <MenuItem Header="Font Size">
                    <MenuItem Header="10" Tag="10" Click="FontSizeMenu_Click" />
                    <MenuItem Header="12" Tag="12" Click="FontSizeMenu_Click" />
                    <MenuItem Header="14" Tag="14" Click="FontSizeMenu_Click" />
                    <MenuItem Header="16" Tag="16" Click="FontSizeMenu_Click" />
                    <MenuItem Header="18" Tag="18" Click="FontSizeMenu_Click" />
                    <MenuItem Header="20" Tag="20" Click="FontSizeMenu_Click" />
                    <MenuItem Header="24" Tag="24" Click="FontSizeMenu_Click" />
                    <MenuItem Header="28" Tag="28" Click="FontSizeMenu_Click" />
                    <MenuItem Header="32" Tag="32" Click="FontSizeMenu_Click" />
                </MenuItem>
            </MenuItem>
            <MenuItem Header="Insert">
                <MenuItem Header="Timestamp" Click="InsertTimestamp_Click" InputGestureText="Ctrl+T" />
            </MenuItem>
            <Separator/>

            <!-- 2. Note Operations & Search -->
            <MenuItem Header="New Note" Click="NewNoteButton_Click" InputGestureText="Ctrl+N" />
            <MenuItem Header="Duplicate Note" Click="DuplicateNote_Click"/>
            <MenuItem Header="Search Notes" Click="SearchNoteButton_Click" InputGestureText="Ctrl+Alt+S"/>
            <MenuItem Header="Note Manager" Click="NoteManagerMenu_Click"/>
            <MenuItem Header="Export as Text File..." Click="ExportNoteAsText_Click"/>
            <Separator/>

            <!-- 3. Appearance -->
            <MenuItem Header="Color">
                <MenuItem Header="Yellow" Click="ColorMenu_Click" Tag="#FFF9C4">
                    <MenuItem.Icon><Rectangle Width="14" Height="14" Fill="#FFF9C4" RadiusX="2" RadiusY="2" Stroke="#80000000" StrokeThickness="0.5"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Orange" Click="ColorMenu_Click" Tag="#FFE0B2">
                    <MenuItem.Icon><Rectangle Width="14" Height="14" Fill="#FFE0B2" RadiusX="2" RadiusY="2" Stroke="#80000000" StrokeThickness="0.5"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Green" Click="ColorMenu_Click" Tag="#A5D6A7">
                    <MenuItem.Icon><Rectangle Width="14" Height="14" Fill="#A5D6A7" RadiusX="2" RadiusY="2" Stroke="#80000000" StrokeThickness="0.5"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Teal" Click="ColorMenu_Click" Tag="#80CBC4">
                    <MenuItem.Icon><Rectangle Width="14" Height="14" Fill="#80CBC4" RadiusX="2" RadiusY="2" Stroke="#80000000" StrokeThickness="0.5"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Blue" Click="ColorMenu_Click" Tag="#90CAF9">
                    <MenuItem.Icon><Rectangle Width="14" Height="14" Fill="#90CAF9" RadiusX="2" RadiusY="2" Stroke="#80000000" StrokeThickness="0.5"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Purple" Click="ColorMenu_Click" Tag="#CE93D8">
                    <MenuItem.Icon><Rectangle Width="14" Height="14" Fill="#CE93D8" RadiusX="2" RadiusY="2" Stroke="#80000000" StrokeThickness="0.5"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Pink" Click="ColorMenu_Click" Tag="#F48FB1">
                    <MenuItem.Icon><Rectangle Width="14" Height="14" Fill="#F48FB1" RadiusX="2" RadiusY="2" Stroke="#80000000" StrokeThickness="0.5"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="White" Click="ColorMenu_Click" Tag="#FAFAFA">
                    <MenuItem.Icon><Rectangle Width="14" Height="14" Fill="#FAFAFA" RadiusX="2" RadiusY="2" Stroke="#80000000" StrokeThickness="0.5"/></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Gray" Click="ColorMenu_Click" Tag="#E0E0E0">
                    <MenuItem.Icon><Rectangle Width="14" Height="14" Fill="#E0E0E0" RadiusX="2" RadiusY="2" Stroke="#80000000" StrokeThickness="0.5"/></MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Custom Color..." Click="CustomColorMenu_Click"/>
            </MenuItem>
            <MenuItem x:Name="OpacityMenuItem" Header="Opacity">
                <MenuItem Header="100%" Click="OpacityMenu_Click" Tag="1.0" IsCheckable="True"/>
                <MenuItem Header="90%" Click="OpacityMenu_Click" Tag="0.90" IsCheckable="True"/>
                <MenuItem Header="80%" Click="OpacityMenu_Click" Tag="0.80" IsCheckable="True"/>
                <MenuItem Header="70%" Click="OpacityMenu_Click" Tag="0.70" IsCheckable="True"/>
                <MenuItem Header="60%" Click="OpacityMenu_Click" Tag="0.60" IsCheckable="True"/>
                <MenuItem Header="50%" Click="OpacityMenu_Click" Tag="0.50" IsCheckable="True"/>
                <MenuItem Header="40%" Click="OpacityMenu_Click" Tag="0.40" IsCheckable="True"/>
                <MenuItem Header="30%" Click="OpacityMenu_Click" Tag="0.30" IsCheckable="True"/>
            </MenuItem>
            <Separator/>

            <!-- 4. Behavior, Security & Reminders -->
            <MenuItem x:Name="AlwaysOnTopMenuItem" Header="Always on Top" IsCheckable="True" Click="AlwaysOnTopMenu_Click"/>
            <MenuItem x:Name="ClickThroughMenuItem" Header="Enable Click-Through" Click="ClickThroughMenu_Click"/>
            <MenuItem x:Name="LockNoteMenuItem" Header="Lock Note" Click="LockNoteButton_Click" InputGestureText="Ctrl+Shift+L"/>
            <MenuItem x:Name="HideFromCaptureMenuItem" Header="Hide from Screen Share" IsCheckable="True" Click="HideFromCaptureMenu_Click"/>
            <MenuItem Header="Set Reminder..." Click="SetReminder_Click"/>
            <Separator/>

            <!-- 5. Note Lifecycle -->
            <MenuItem Header="Close Note" Click="CloseNoteMenu_Click"/>
            <MenuItem Header="Delete Note" Click="DeleteNoteButton_Click"/>
            <Separator/>

            <!-- 6. Application -->
            <MenuItem Header="Settings..." Click="SettingsMenu_Click"/>
            <MenuItem Header="Help &amp; Features" Click="HelpMenu_Click" FontWeight="SemiBold"/>
            <MenuItem Header="Exit PermaNotes" Click="ExitAppMenu_Click"/>
        </ContextMenu>

        <!-- Sleek ScrollBar Style -->
        <Style x:Key="SleekScrollThumbStyle" TargetType="Thumb">
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbBorder" HorizontalAlignment="Right" Margin="0,0,2,0">
                            <!-- Animation for smooth width expansion -->
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Width" Value="4"/>
                                    <Setter Property="Background" Value="#40000000"/>
                                    <Setter Property="CornerRadius" Value="2"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Thumb}}" Value="True">
                                            <Setter Property="Width" Value="10"/>
                                            <Setter Property="Background" Value="#60000000"/>
                                            <Setter Property="CornerRadius" Value="5"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsDragging, RelativeSource={RelativeSource AncestorType=Thumb}}" Value="True">
                                            <Setter Property="Width" Value="10"/>
                                            <Setter Property="Background" Value="#90000000"/>
                                            <Setter Property="CornerRadius" Value="5"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="true">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SleekScrollThumbStyle}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Header button style (+ ✕ icons) -->
        <Style x:Key="HeaderButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#777777"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#15000000"/>
                                <Setter Property="Foreground" Value="#333333"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style x:Key="ResizeThumbStyle" TargetType="Thumb">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FormatToolbarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#55FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ImageWidthOptionStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#BAC1CC"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Surface" Background="Transparent" CornerRadius="6" BorderThickness="1"
                                Padding="0,5" Margin="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#303946"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#263F42"/>
                                <Setter Property="Foreground" Value="#B4F2E1"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#98DDCC"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ImageMenuActionStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#E5E9EF"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="6"
                                BorderThickness="1" Padding="7,4" Margin="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="23"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Path Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Center"
                                      Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                      Stroke="{TemplateBinding Foreground}" StrokeThickness="1.35" Stretch="Uniform"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#28333C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#30434A"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#98DDCC"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <!-- A translucent edge gives the card depth without a cached blur surface. -->
        <Border CornerRadius="15" BorderThickness="1,1,1,2" BorderBrush="#26000000"
                Margin="-1,-1,-1,-2" IsHitTestVisible="False"/>

        <Border x:Name="CardBorder" Background="#FFF9C4" BorderBrush="Transparent" Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="36"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header / Drag Bar -->
                <Grid Grid.Row="0" x:Name="HeaderGrid" Background="Transparent" 
                      MouseLeftButtonDown="Header_MouseLeftButtonDown"
                      Margin="4,4,4,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Title: TextBlock by default, TextBox on double-click -->
                    <TextBlock x:Name="TitleBlock" Grid.Column="0" 
                               Margin="12,0,0,0" 
                               VerticalAlignment="Center" 
                               HorizontalAlignment="Left"
                               FontFamily="Inter, Roboto, Segoe UI Variable, Segoe UI"
                               FontWeight="SemiBold" 
                               FontSize="14" 
                               Foreground="#444444"
                               TextTrimming="CharacterEllipsis"
                               ForceCursor="True"
                               MouseLeftButtonDown="TitleBlock_MouseLeftButtonDown"/>

                    <TextBox x:Name="TitleEditBox" Grid.Column="0" 
                             Margin="10,2,4,2" 
                             VerticalAlignment="Center" 
                             HorizontalAlignment="Left"
                             MinWidth="120"
                             FontFamily="Inter, Roboto, Segoe UI Variable, Segoe UI"
                             FontWeight="SemiBold" 
                             FontSize="14" 
                             Foreground="#333333" 
                             Background="#30FFFFFF" 
                             BorderThickness="0"
                             Padding="4,2"
                             ForceCursor="True"
                             Visibility="Collapsed"
                             LostFocus="TitleEditBox_LostFocus"
                             KeyDown="TitleEditBox_KeyDown"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                        <TextBlock x:Name="SavedIndicator" 
                                   Text="Saved" 
                                   FontSize="11" 
                                   Foreground="#88333333" 
                                   Margin="0,0,8,0"
                                   Opacity="0"/>
                        <Button x:Name="ReminderBadgeBtn" 
                                Cursor="Hand"
                                Click="ReminderBadge_Click"
                                Visibility="Collapsed"
                                ToolTip="Reminder is set"
                                Foreground="#8C3F00"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Margin="0,0,4,0"
                                VerticalContentAlignment="Center">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="#FFF3E0" 
                                            BorderBrush="#FFB74D" 
                                            BorderThickness="1"
                                            Padding="5,1" 
                                            CornerRadius="4">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                    
                    <Button x:Name="HideFromCaptureBtn" Grid.Column="2" Style="{StaticResource HeaderButtonStyle}" 
                            ToolTip="Hide from Screen Share" Click="HideFromCaptureBtn_Click" Margin="0,0,2,0">
                        <Path x:Name="HideFromCaptureIcon" Data="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z" 
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" 
                              Stretch="Uniform" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>

                    <Button x:Name="ClickThroughBtn" Grid.Column="3" Style="{StaticResource HeaderButtonStyle}" 
                            ToolTip="Enable Click-Through" Click="ClickThroughMenu_Click" Margin="0,0,2,0">
                        <Path Data="M21,3H7C5.89,3,5,3.89,5,5v4H3v12c0,1.1,0.89,2,2,2h12v-2H5V11h14v2h2V5C21,3.89,20.1,3,21,3z M19,9H7V5h12V9z M14,14v8l2.25-2.25l2.5,4.25l1.5-0.75l-2.5-4.25l3.5,0L14,14z" 
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" 
                              Stretch="Uniform" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>

                    <Button x:Name="LockNoteBtn" Grid.Column="4" Style="{StaticResource HeaderButtonStyle}" 
                            ToolTip="Lock Note" Click="LockNoteButton_Click" Margin="0,0,2,0">
                        <Path x:Name="LockIconPath" Data="M 19 9 L 5 9 C 3.9 9 3 9.9 3 11 L 3 20 C 3 21.1 3.9 22 5 22 L 19 22 C 20.1 22 21 21.1 21 20 L 21 11 C 21 9.9 20.1 9 19 9 Z M 10 9 L 10 6 C 10 2.7 7.3 0 4 0 C 0.7 0 -2 2.7 -2 6 L -2 15 C -2 16.1 -0.9 17 0 17 C 0.9 17 2 16.1 2 15 L 2 6 C 2 4.9 2.9 4 4 4 C 5.1 4 6 4.9 6 6 L 6 9 Z M 12 17 A 1.5 1.5 0 0 0 12.75 14.33 L 12.75 12 A 0.75 0.75 0 0 0 11.25 12 L 11.25 14.33 A 1.5 1.5 0 0 0 12 17 Z" 
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" 
                              Stretch="Uniform" Width="13" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>

                    <Button x:Name="NewNoteBtn" Grid.Column="5" Style="{StaticResource HeaderButtonStyle}" 
                            ToolTip="New Note" Click="NewNoteButton_Click" Margin="0,0,2,0">
                        <Path Data="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H10v-2H6V4h7v5h5v3h2V8l-6-6zM18 15v3h-3v2h3v3h2v-3h3v-2h-3v-3h-2z" 
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" 
                              Stretch="Uniform" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>

                    <Button x:Name="SearchNoteBtn" Grid.Column="6" Style="{StaticResource HeaderButtonStyle}" 
                            ToolTip="Search Notes" Click="SearchNoteButton_Click" Margin="0,0,2,0">
                        <Path Data="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H11v-2H6V4h7v5h5v4h2V8l-6-6zM15.5 15c-1.93 0-3.5 1.57-3.5 3.5s1.57 3.5 3.5 3.5c.71 0 1.37-.23 1.9-.61l2.69 2.69 1.41-1.41-2.69-2.69c.38-.53.61-1.19.61-1.9 0-1.93-1.57-3.5-3.5-3.5zm0 5c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5z" 
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" 
                              Stretch="Uniform" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>

                    <Button x:Name="DeleteNoteBtn" Grid.Column="7" Style="{StaticResource HeaderButtonStyle}" 
                            ToolTip="Delete Note" Click="DeleteNoteButton_Click" Margin="0,0,2,0">
                        <Path Data="M 9 3 L 9 4 L 4 4 L 4 6 L 5 6 L 5 20 C 5 21.104569 5.8954305 22 7 22 L 17 22 C 18.104569 22 19 21.104569 19 20 L 19 6 L 20 6 L 20 4 L 15 4 L 15 3 C 15 1.8954305 14.104569 1 13 1 L 11 1 C 9.8954305 1 9 1.8954305 9 3 z M 11 3 L 13 3 L 13 4 L 11 4 L 11 3 z M 7 6 L 17 6 L 17 20 L 7 20 L 7 6 z M 9 8 L 11 8 L 11 18 L 9 18 L 9 8 z M 13 8 L 15 8 L 15 18 L 13 18 L 13 8 z" 
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" 
                              Stretch="Uniform" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>

                    <Button x:Name="CloseNoteBtn" Grid.Column="8" Content="✕" Style="{StaticResource HeaderButtonStyle}" 
                            ToolTip="Close Note" Click="CloseNoteButton_Click" Margin="0,0,6,0"/>
                </Grid>

                <!-- Rich Text Content Editor -->
                <RichTextBox x:Name="ContentRichTextBox" Grid.Row="1" 
                             Margin="16,4,16,16" 
                             AcceptsReturn="True" 
                             AcceptsTab="True" 
                             VerticalScrollBarVisibility="Auto" 
                             ScrollViewer.CanContentScroll="False"
                             Background="Transparent" 
                             BorderThickness="0" 
                             FontSize="15" 
                             Foreground="#333333" 
                             FontFamily="Inter, Roboto, Segoe UI Variable, Segoe UI"
                             PreviewMouseMove="ContentRichTextBox_PreviewMouseMove"
                             MouseLeave="ContentRichTextBox_MouseLeave"
                             PreviewMouseWheel="ContentRichTextBox_PreviewMouseWheel"
                             PreviewMouseUp="ContentRichTextBox_PreviewMouseUp"
                             PreviewMouseLeftButtonDown="ContentRichTextBox_PreviewMouseLeftButtonDown"
                             PreviewMouseRightButtonUp="ContentRichTextBox_PreviewMouseRightButtonUp"
                             PreviewKeyDown="ContentRichTextBox_PreviewKeyDown"
                             SelectionChanged="ContentRichTextBox_SelectionChanged"
                             TextChanged="ContentRichTextBox_TextChanged"
                             IsDocumentEnabled="True"
                             ContextMenu="{DynamicResource NoteContextMenu}"
                             AllowDrop="True"
                             PreviewDragOver="ContentRichTextBox_DragOver"
                             Drop="ContentRichTextBox_Drop"
                             SizeChanged="ContentRichTextBox_SizeChanged">
                </RichTextBox>

                <!-- Subtle corner grip decoration -->
                <Canvas Grid.Row="1" Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,5,5" IsHitTestVisible="False" Opacity="0.3">
                    <Line X1="8" Y1="2" X2="2" Y2="8" Stroke="{Binding Foreground, ElementName=ContentRichTextBox}" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    <Line X1="8" Y1="5" X2="5" Y2="8" Stroke="{Binding Foreground, ElementName=ContentRichTextBox}" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Canvas>
            </Grid>
        </Border>

        <!-- Perimeter Resize Thumbs (8 directions) -->
        <Grid x:Name="ResizeGrid" Margin="0">
            <!-- 4 Corners -->
            <Thumb Tag="TopLeft" Cursor="SizeNWSE" HorizontalAlignment="Left" VerticalAlignment="Top" Width="16" Height="16" Margin="-4,-4,0,0" Style="{StaticResource ResizeThumbStyle}" DragStarted="ResizeThumb_DragStarted" DragDelta="ResizeThumb_DragDelta" DragCompleted="ResizeThumb_DragCompleted"/>
            <Thumb Tag="TopRight" Cursor="SizeNESW" HorizontalAlignment="Right" VerticalAlignment="Top" Width="16" Height="16" Margin="0,-4,-4,0" Style="{StaticResource ResizeThumbStyle}" DragStarted="ResizeThumb_DragStarted" DragDelta="ResizeThumb_DragDelta" DragCompleted="ResizeThumb_DragCompleted"/>
            <Thumb Tag="BottomLeft" Cursor="SizeNESW" HorizontalAlignment="Left" VerticalAlignment="Bottom" Width="16" Height="16" Margin="-4,0,0,-4" Style="{StaticResource ResizeThumbStyle}" DragStarted="ResizeThumb_DragStarted" DragDelta="ResizeThumb_DragDelta" DragCompleted="ResizeThumb_DragCompleted"/>
            <Thumb Tag="BottomRight" Cursor="SizeNWSE" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="18" Height="18" Margin="0,0,-4,-4" Style="{StaticResource ResizeThumbStyle}" DragStarted="ResizeThumb_DragStarted" DragDelta="ResizeThumb_DragDelta" DragCompleted="ResizeThumb_DragCompleted"/>

            <!-- 4 Edges -->
            <Thumb Tag="Top" Cursor="SizeNS" HorizontalAlignment="Stretch" VerticalAlignment="Top" Height="8" Margin="12,-4,12,0" Style="{StaticResource ResizeThumbStyle}" DragStarted="ResizeThumb_DragStarted" DragDelta="ResizeThumb_DragDelta" DragCompleted="ResizeThumb_DragCompleted"/>
            <Thumb Tag="Bottom" Cursor="SizeNS" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Height="8" Margin="12,0,12,-4" Style="{StaticResource ResizeThumbStyle}" DragStarted="ResizeThumb_DragStarted" DragDelta="ResizeThumb_DragDelta" DragCompleted="ResizeThumb_DragCompleted"/>
            <Thumb Tag="Left" Cursor="SizeWE" HorizontalAlignment="Left" VerticalAlignment="Stretch" Width="8" Margin="-4,12,0,12" Style="{StaticResource ResizeThumbStyle}" DragStarted="ResizeThumb_DragStarted" DragDelta="ResizeThumb_DragDelta" DragCompleted="ResizeThumb_DragCompleted"/>
            <Thumb Tag="Right" Cursor="SizeWE" HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="8" Margin="0,12,-4,12" Style="{StaticResource ResizeThumbStyle}" DragStarted="ResizeThumb_DragStarted" DragDelta="ResizeThumb_DragDelta" DragCompleted="ResizeThumb_DragCompleted"/>
        </Grid>

        <!-- Formatting Popup -->
        <Popup x:Name="FormatPopup" AllowsTransparency="True" StaysOpen="False" Placement="MousePoint" HorizontalOffset="-30" VerticalOffset="-40">
            <Border Background="#DD1A1A1A" CornerRadius="8" BorderBrush="#555555" BorderThickness="1" Padding="4">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.4" Direction="270"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource FormatToolbarButtonStyle}" Command="EditingCommands.ToggleBold" CommandTarget="{Binding ElementName=ContentRichTextBox}" ToolTip="Bold">
                        <TextBlock Text="B" FontWeight="Bold" FontSize="14" Foreground="White" Margin="0,0,0,1"/>
                    </Button>
                    <Button Style="{StaticResource FormatToolbarButtonStyle}" Command="EditingCommands.ToggleItalic" CommandTarget="{Binding ElementName=ContentRichTextBox}" ToolTip="Italic">
                        <TextBlock Text="I" FontStyle="Italic" FontSize="14" FontFamily="Georgia" Foreground="White"/>
                    </Button>
                    <Button Style="{StaticResource FormatToolbarButtonStyle}" Command="EditingCommands.ToggleUnderline" CommandTarget="{Binding ElementName=ContentRichTextBox}" ToolTip="Underline">
                        <TextBlock Text="U" TextDecorations="Underline" FontSize="14" Foreground="White" Margin="0,0,0,1"/>
                    </Button>
                    <Button Style="{StaticResource FormatToolbarButtonStyle}" Click="StrikethroughText_Click" ToolTip="Strikethrough (Ctrl+Shift+X)">
                        <TextBlock Text="S" TextDecorations="Strikethrough" FontSize="14" Foreground="White" Margin="0,0,0,1"/>
                    </Button>
                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="2" Background="#444444"/>
                    <Button Style="{StaticResource FormatToolbarButtonStyle}" Click="HighlightText_Click" ToolTip="Highlight (Ctrl+H)">
                        <Path Data="M3 14 L3 17 L6 17 L17.5 5.5 L14.5 2.5 Z M14.5 5.5 L6 14" Fill="White" Stretch="Uniform" Width="12" Height="12"/>
                    </Button>
                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="2" Background="#444444"/>
                    <Button Style="{StaticResource FormatToolbarButtonStyle}" Command="EditingCommands.ToggleBullets" CommandTarget="{Binding ElementName=ContentRichTextBox}" ToolTip="Bullet List">
                        <Path Data="M3 4 A 1.5 1.5 0 1 1 3 7 A 1.5 1.5 0 0 1 3 4 Z M8 5 L18 5 L18 6 L8 6 Z M3 11 A 1.5 1.5 0 1 1 3 14 A 1.5 1.5 0 0 1 3 11 Z M8 12 L18 12 L18 13 L8 13 Z" Fill="White" Stretch="Uniform" Width="12" Height="12"/>
                    </Button>
                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="2" Background="#444444"/>
                    <Button Style="{StaticResource FormatToolbarButtonStyle}" Click="IncreaseFontSize_Click" ToolTip="Increase Font Size">
                        <TextBlock Text="A↑" FontSize="12" Foreground="White"/>
                    </Button>
                    <Button Style="{StaticResource FormatToolbarButtonStyle}" Click="DecreaseFontSize_Click" ToolTip="Decrease Font Size">
                        <TextBlock Text="A↓" FontSize="12" Foreground="White"/>
                    </Button>
                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="2" Background="#444444"/>
                    <Button Style="{StaticResource FormatToolbarButtonStyle}" Command="ApplicationCommands.Undo" CommandTarget="{Binding ElementName=ContentRichTextBox}" ToolTip="Undo (Ctrl+Z)">
                        <TextBlock Text="↶" FontSize="16" Foreground="White" Margin="0,-2,0,0"/>
                    </Button>
                    <Button Style="{StaticResource FormatToolbarButtonStyle}" Command="ApplicationCommands.Redo" CommandTarget="{Binding ElementName=ContentRichTextBox}" ToolTip="Redo (Ctrl+Y)">
                        <TextBlock Text="↷" FontSize="16" Foreground="White" Margin="0,-2,0,0"/>
                    </Button>
                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="2" Background="#444444"/>
                    <Button Style="{StaticResource FormatToolbarButtonStyle}" Click="InsertTimestamp_Click" ToolTip="Insert Timestamp (Ctrl+T)">
                        <TextBlock Text="🕐" FontSize="12" Foreground="White"/>
                    </Button>
                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="2" Background="#444444"/>
                    <Button x:Name="HyperlinksToolbarButton" Style="{StaticResource FormatToolbarButtonStyle}" Click="HyperlinksToolbarButton_Click" ToolTip="Format as Link (or toggle hyperlinks)">
                        <Path x:Name="HyperlinksToolbarPath" Data="M3.9 12c0-1.71 1.39-3.1 3.1-3.1h4V7H7c-2.76 0-5 2.24-5 5s2.24 5 5 5h4v-1.9H7c-1.71 0-3.1-1.39-3.1-3.1zM8 13h8v-2H8v2zm9-6h-4v1.9h4c1.71 0 3.1 1.39 3.1 3.1s-1.39 3.1-3.1 3.1h-4V17h4c2.76 0 5-2.24 5-5s-2.24-5-5-5z" Fill="White" Stretch="Uniform" Width="12" Height="12"/>
                    </Button>
                </StackPanel>
            </Border>
        </Popup>
        <!-- Hyperlink Action Popup -->
        <Popup x:Name="HyperlinkActionPopup" AllowsTransparency="True" StaysOpen="False" Placement="Relative" PlacementTarget="{Binding ElementName=ContentRichTextBox}">
            <Border Background="#F21E1E1E" CornerRadius="8" BorderBrush="#555555" BorderThickness="1" Padding="6,3">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="3" Opacity="0.45" Direction="270"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="M3.9 12c0-1.71 1.39-3.1 3.1-3.1h4V7H7c-2.76 0-5 2.24-5 5s2.24 5 5 5h4v-1.9H7c-1.71 0-3.1-1.39-3.1-3.1zM8 13h8v-2H8v2zm9-6h-4v1.9h4c1.71 0 3.1 1.39 3.1 3.1s-1.39 3.1-3.1 3.1h-4V17h4c2.76 0 5-2.24 5-5s-2.24-5-5-5z"
                          Fill="#888888" Stretch="Uniform" Width="11" Height="11" VerticalAlignment="Center" Margin="3,0,5,0"/>
                    <TextBlock x:Name="HyperlinkPopupUrlText" Text="https://example.com" MaxWidth="220" TextTrimming="CharacterEllipsis"
                               Foreground="#61AFEF" FontSize="11" VerticalAlignment="Center" Cursor="Hand" Margin="0,0,4,0"
                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                               MouseLeftButtonDown="HyperlinkPopupUrlText_MouseLeftButtonDown">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="TextDecorations" Value="Underline"/>
                                        <Setter Property="Foreground" Value="#80D0FF"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="3,2,3,2" Background="#444444"/>

                    <!-- Copy Link Button -->
                    <Button x:Name="CopyHyperlinkBtn" Style="{StaticResource FormatToolbarButtonStyle}" Click="CopyHyperlinkBtn_Click" ToolTip="Copy link address" Width="22" Height="22" Margin="1,0,2,0">
                        <Path Data="M3 1 C2.4 1 2 1.4 2 2 L2 8 C2 8.6 2.4 9 3 9 L4 9 L4 11 C4 11.6 4.4 12 5 12 L10 12 C10.6 12 11 11.6 11 11 L11 5 C11 4.4 10.6 4 10 4 L9 4 L9 2 C9 1.4 8.6 1 8 1 L3 1 Z M4 2 L8 2 L8 4 L5 4 C4.4 4 4 4.4 4 5 L4 10 L3 10 L3 2 Z M5 5 L10 5 L10 11 L5 11 L5 5 Z"
                              Fill="#CCCCCC" Width="10" Height="10" Stretch="Uniform"/>
                    </Button>
                </StackPanel>
            </Border>
        </Popup>

        <!-- Image Action Popup -->
        <Popup x:Name="ImageActionPopup" AllowsTransparency="True" StaysOpen="False" Placement="MousePoint">
            <Border Width="294" Background="#191E25" CornerRadius="11" BorderBrush="#46535F"
                    BorderThickness="1" Padding="9" SnapsToDevicePixels="True" UseLayoutRounding="True"
                    KeyboardNavigation.TabNavigation="Cycle">
                <StackPanel>
                    <TextBlock Text="Image width" Foreground="#BAC1CC" FontSize="11" FontWeight="SemiBold" Margin="5,1,0,6"/>
                    <Border CornerRadius="8" Background="#222A34" Padding="2">
                        <UniformGrid Rows="1">
                            <RadioButton x:Name="ImageRatio30Btn" GroupName="ImageWidth" Style="{StaticResource ImageWidthOptionStyle}" Content="30%" Tag="0.30" Click="ImageSizePreset_Click" ToolTip="30% of note width"/>
                            <RadioButton x:Name="ImageRatio50Btn" GroupName="ImageWidth" Style="{StaticResource ImageWidthOptionStyle}" Content="50%" Tag="0.50" Click="ImageSizePreset_Click" ToolTip="50% of note width"/>
                            <RadioButton x:Name="ImageRatio75Btn" GroupName="ImageWidth" Style="{StaticResource ImageWidthOptionStyle}" Content="75%" Tag="0.75" Click="ImageSizePreset_Click" ToolTip="75% of note width"/>
                            <RadioButton x:Name="ImageRatio100Btn" GroupName="ImageWidth" Style="{StaticResource ImageWidthOptionStyle}" Content="100%" Tag="1.00" Click="ImageSizePreset_Click" ToolTip="100% of note width"/>
                        </UniformGrid>
                    </Border>
                    <UniformGrid Columns="2" Margin="0,7,0,0">
                        <Button x:Name="ViewImageFullBtn" Style="{StaticResource ImageMenuActionStyle}" Content="View full size" Click="OpenFullSizeImageBtn_Click"
                                Tag="M2,6 V2 H6 M10,2 H14 V6 M14,10 V14 H10 M6,14 H2 V10 M5,11 L11,5 M7,5 H11 V9"/>
                        <Button x:Name="CopyImageBtn" Style="{StaticResource ImageMenuActionStyle}" Content="Copy image" Click="CopyImageBtn_Click"
                                Tag="M5,5 H14 V14 H5 Z M2,11 V2 H11"/>
                        <Button x:Name="SaveImageAsBtn" Style="{StaticResource ImageMenuActionStyle}" Content="Export PNG/JPEG…" Click="SaveImageAsBtn_Click"
                                Tag="M7,3 H2 V14 H13 V9 M8,2 H14 V8 M14,2 L7,9"/>
                        <Button x:Name="SaveOriginalImageBtn" Style="{StaticResource ImageMenuActionStyle}" Content="Save original…" Click="SaveOriginalImageBtn_Click"
                                ToolTip="Save a copy in its original file format" Tag="M8,2 V10 M5,7 L8,10 L11,7 M2,11 V14 H14 V11"/>
                        <Button Style="{StaticResource ImageMenuActionStyle}" Content="Reload image" Click="RetryImageBtn_Click"
                                ToolTip="Load the linked file again" Tag="M13,6 A5.5,5.5 0 1 0 13,11 M13,2 V6 H9"/>
                        <Button x:Name="RelinkImageBtn" Style="{StaticResource ImageMenuActionStyle}" Content="Replace image…" Click="RelinkImageBtn_Click"
                                ToolTip="Choose a replacement file or locate the original" Tag="M2,9 V3 H10 M2,6 H12 M9,3 L12,6 L9,9 M14,7 V13 H6 M14,10 H4 M7,7 L4,10 L7,13"/>
                    </UniformGrid>
                    <Border Height="1" Background="#39444F" Margin="4,4,4,3"/>
                    <Button x:Name="DeleteImageBtn" Style="{StaticResource ImageMenuActionStyle}" Content="Remove from note" Foreground="#FFADAD" Click="DeleteImageBtn_Click"
                            Tag="M2,4 H14 M6,4 V2 H10 V4 M4,4 L5,14 H11 L12,4 M7,7 V11 M9,7 V11"/>
                </StackPanel>
            </Border>
        </Popup>

        <!-- Reminder Popup -->
        <Popup x:Name="ReminderPopup" AllowsTransparency="True" StaysOpen="False" Placement="Center">
            <Border Background="#F9F9F9" CornerRadius="8" BorderBrush="#CCCCCC" BorderThickness="1" Padding="12" Width="240">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="4" Opacity="0.3" Direction="270"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Set Reminder" FontWeight="Bold" FontSize="14" Margin="0,0,0,10" Foreground="#333333"/>
                    
                    <TextBlock Text="Date" FontSize="11" Foreground="#666666" Margin="0,0,0,2"/>
                    <DatePicker x:Name="ReminderDatePicker" Margin="0,0,0,8" />
                    
                    <TextBlock Text="Time (HH:mm)" FontSize="11" Foreground="#666666" Margin="0,0,0,2"/>
                    <TextBox x:Name="ReminderTimeTextBox" Margin="0,0,0,8" Padding="2" Text="12:00" />
                    
                    <TextBlock Text="Reminder Text" FontSize="11" Foreground="#666666" Margin="0,0,0,2"/>
                    <TextBox x:Name="ReminderTextBox" Margin="0,0,0,12" Padding="2" AcceptsReturn="True" Height="40" TextWrapping="Wrap"/>
                    
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="RemoveReminderBtn" Content="Remove" Margin="0,0,8,0" Padding="8,4" Background="#FFDDDD" BorderBrush="#FF9999" Click="RemoveReminder_Click" Visibility="Collapsed" />
                        <Button Content="Cancel" Margin="0,0,8,0" Padding="8,4" Click="CancelReminderPopup_Click" />
                        <Button Content="Save" Padding="8,4" Background="#E0F0FF" BorderBrush="#BBDDFF" Click="SaveReminder_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>

<Window x:Class="DesktopNotes.Views.ColorWheelDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pick a Color"
        Width="340" Height="460"
        MinWidth="300" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="#F5F5F5">

    <Window.Resources>
        <Style x:Key="FlatRepeatButton" TargetType="RepeatButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SliderThumbStyle" TargetType="Thumb">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Ellipse Fill="White" Stroke="#888" StrokeThickness="1.5">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.4" Color="Black"/>
                            </Ellipse.Effect>
                        </Ellipse>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SliderStyle" TargetType="Slider">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource FlatRepeatButton}" Command="Slider.DecreaseLarge"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SliderThumbStyle}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource FlatRepeatButton}" Command="Slider.IncreaseLarge"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <!-- Color wheel -->
            <RowDefinition Height="*"/>
            <!-- Brightness label + track -->
            <RowDefinition Height="Auto"/>
            <!-- Preview + Hex -->
            <RowDefinition Height="Auto"/>
            <!-- Buttons -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Color Wheel Canvas ── -->
        <Border Grid.Row="0" CornerRadius="4" ClipToBounds="True"
                BorderBrush="#DDD" BorderThickness="1"
                Background="White" Margin="0,0,0,12">
            <Canvas x:Name="WheelCanvas"
                    Background="Transparent"
                    Cursor="Cross"
                    ForceCursor="True"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    MouseLeftButtonDown="Wheel_MouseDown"
                    MouseMove="Wheel_MouseMove"
                    MouseLeftButtonUp="Wheel_MouseUp"
                    SizeChanged="WheelCanvas_SizeChanged">
                <Image x:Name="WheelImage"
                       IsHitTestVisible="False"/>
                <Ellipse x:Name="CrosshairOuter" Width="16" Height="16"
                         Stroke="White" StrokeThickness="2"
                         Fill="Transparent" IsHitTestVisible="False"
                         Canvas.Left="100" Canvas.Top="100"/>
                <Ellipse x:Name="CrosshairInner" Width="6" Height="6"
                         Fill="White" IsHitTestVisible="False"
                         Canvas.Left="105" Canvas.Top="105">
                    <Ellipse.Effect>
                        <DropShadowEffect BlurRadius="2" ShadowDepth="0" Opacity="0.6" Color="Black"/>
                    </Ellipse.Effect>
                </Ellipse>
            </Canvas>
        </Border>

        <!-- ── Brightness ── -->
        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="Brightness" FontSize="13" Foreground="#555" Margin="0,0,0,4"/>
            <Border x:Name="BrightnessTrack" CornerRadius="4" Height="16"
                    BorderBrush="#CCC" BorderThickness="1" ClipToBounds="True"/>
            <Slider x:Name="BrightnessSlider" Minimum="0" Maximum="1"
                    Margin="0,-20,0,0"
                    Style="{StaticResource SliderStyle}"
                    ValueChanged="BrightnessSlider_ValueChanged"/>
        </StackPanel>

        <!-- ── Preview + Hex ── -->
        <Grid Grid.Row="2" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="52"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Swatch -->
            <Border x:Name="PreviewSwatch" Grid.Column="0"
                    Width="48" Height="48" CornerRadius="4"
                    Background="#FFF9C4"
                    BorderBrush="#CCC" BorderThickness="1"/>

            <!-- Hex input -->
            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Hex Color" FontSize="13" Foreground="#555" Margin="0,0,0,4"/>
                <Border BorderBrush="#BBB" BorderThickness="1" CornerRadius="3" Background="White">
                    <Grid>
                        <TextBlock Text="#" Foreground="#888" FontSize="14"
                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                        <TextBox x:Name="HexTextBox"
                                 Margin="20,0,6,0" Height="32"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="#222"
                                 FontSize="14" FontFamily="Consolas"
                                 VerticalContentAlignment="Center"
                                 MaxLength="6"
                                 TextChanged="HexTextBox_TextChanged"
                                 KeyDown="HexTextBox_KeyDown"/>
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>

        <!-- ── Buttons ── -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="80" Height="32" Margin="0,0,10,0"
                    Click="CancelButton_Click" FontSize="14"
                    Background="#757575" Foreground="White"
                    BorderThickness="0" Cursor="Hand"/>
            <Button Content="Apply" Width="80" Height="32"
                    Click="ApplyButton_Click" FontSize="14"
                    Background="#4CAF50" Foreground="White"
                    BorderThickness="0" Cursor="Hand"/>
        </StackPanel>

    </Grid>
</Window>

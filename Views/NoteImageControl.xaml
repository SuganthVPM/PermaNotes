<UserControl x:Class="DesktopNotes.Views.NoteImageControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <UserControl.Resources>
        <Style x:Key="ImageResizeThumbStyle" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Background="Transparent">
                            <Path Data="M6 11 L11 6 M3 11 L11 3 M8 11 L11 8" Stroke="#99FFFFFF" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,2"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="RootGrid" Cursor="Hand" MouseLeftButtonDown="RootGrid_MouseLeftButtonDown" MouseEnter="RootGrid_MouseEnter" MouseLeave="RootGrid_MouseLeave">
        <Border x:Name="ImageBorder" BorderThickness="1" BorderBrush="#33000000" Background="#0A000000" ClipToBounds="True">
            <Image x:Name="DisplayImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
        </Border>
        <TextBlock x:Name="MissingLabel" Text="Image unavailable" Foreground="Gray" FontStyle="Italic" TextWrapping="Wrap" Margin="6" MinHeight="32" Visibility="Collapsed"/>

        <!-- Hover outline indicator -->
        <Border x:Name="HoverBorder" BorderThickness="1.5" BorderBrush="#007ACC" Visibility="Collapsed" IsHitTestVisible="False"/>

        <!-- Bottom-Right Resize Handle -->
        <Thumb x:Name="ResizeThumb" Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE"
               Style="{StaticResource ImageResizeThumbStyle}" DragDelta="ResizeThumb_DragDelta" DragCompleted="ResizeThumb_DragCompleted"
               ToolTip="Drag to resize (scales responsively with note)"/>
    </Grid>
</UserControl>

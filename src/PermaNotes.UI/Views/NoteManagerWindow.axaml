<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PermaNotes.UI.ViewModels"
        x:Class="PermaNotes.UI.Views.NoteManagerWindow"
        x:DataType="vm:NoteManagerViewModel"
        Title="PermaNotes — Note Manager"
        Width="640" Height="500"
        MinWidth="480" MinHeight="350"
        WindowStartupLocation="CenterScreen"
        Icon="avares://PermaNotes.UI/Assets/icon.ico">

    <DockPanel Margin="16">
        <!-- Header / Search Bar -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <Button DockPanel.Dock="Right"
                    Content="+ New Note"
                    Command="{Binding NewNoteCommand}"
                    Classes="accent"
                    Margin="8,0,0,0"
                    Padding="14,6"
                    FontWeight="SemiBold"/>

            <TextBox Text="{Binding SearchText, Mode=TwoWay}"
                     Watermark="Search notes by title or content..."
                     FontSize="13"
                     VerticalContentAlignment="Center"
                     Height="34"/>
        </DockPanel>

        <!-- Stats Bar -->
        <Border DockPanel.Dock="Top"
                Background="#10000000"
                CornerRadius="6"
                Padding="12,6"
                Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" Spacing="16">
                <TextBlock Text="{Binding TotalCount, StringFormat='Total Notes: {0}'}"
                           FontSize="12"
                           FontWeight="Medium"/>
                <TextBlock Text="{Binding OpenCount, StringFormat='🟢 Open: {0}'}"
                           FontSize="12"
                           Foreground="#2E7D32"
                           FontWeight="Medium"/>
                <TextBlock Text="{Binding ClosedCount, StringFormat='⚪ Closed: {0}'}"
                           FontSize="12"
                           Opacity="0.7"
                           FontWeight="Medium"/>
            </StackPanel>
        </Border>

        <!-- Notes List -->
        <Border BorderBrush="#25000000"
                BorderThickness="1"
                CornerRadius="8"
                Background="{DynamicResource SystemRegionBrush}">
            <ListBox Name="NotesListBox"
                     ItemsSource="{Binding DisplayedNotes}"
                     Background="Transparent"
                     DoubleTapped="NotesList_DoubleTapped">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="vm:NoteViewModel" x:CompileBindings="False">
                        <Border Padding="10,8"
                                Margin="0,2"
                                CornerRadius="6"
                                Background="Transparent">
                            <DockPanel LastChildFill="True">
                                <!-- Action Buttons on the Right -->
                                <StackPanel DockPanel.Dock="Right"
                                            Orientation="Horizontal"
                                            Spacing="8"
                                            VerticalAlignment="Center">
                                    <!-- Status Pill -->
                                    <Border CornerRadius="10"
                                            Padding="8,3"
                                            VerticalAlignment="Center"
                                            Background="{Binding StatusBadgeBackground}">
                                        <TextBlock Text="{Binding StatusText}"
                                                   Foreground="{Binding StatusBadgeForeground}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"/>
                                    </Border>

                                    <!-- Open/Close Button -->
                                    <Button Content="{Binding ToggleButtonText}"
                                            Command="{Binding $parent[Window].DataContext.ToggleNoteStateCommand}"
                                            CommandParameter="{Binding}"
                                            Padding="10,4"
                                            FontSize="12"/>

                                    <!-- Delete Button -->
                                    <Button Content="🗑️"
                                            Command="{Binding $parent[Window].DataContext.DeleteNoteCommand}"
                                            CommandParameter="{Binding}"
                                            Padding="6,4"
                                            FontSize="12"
                                            ToolTip.Tip="Delete Note"/>
                                </StackPanel>

                                <!-- Left: Color indicator + Title + Preview -->
                                <Grid ColumnDefinitions="Auto, *" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <Border Grid.Column="0"
                                            Width="16" Height="16"
                                            Margin="0,0,12,0"
                                            CornerRadius="8"
                                            Background="{Binding BackgroundColor}"
                                            BorderBrush="#40000000"
                                            BorderThickness="1"
                                            VerticalAlignment="Center"/>

                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding Title}"
                                                       FontWeight="SemiBold"
                                                       FontSize="13"/>
                                            <TextBlock Text="{Binding TopmostIndicator}"
                                                       FontSize="11"
                                                       Opacity="0.6"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <TextBlock Text="{Binding Text}"
                                                   FontSize="12"
                                                   Opacity="0.6"
                                                   MaxLines="1"
                                                   TextTrimming="CharacterEllipsis"/>

                                        <TextBlock Text="{Binding UpdatedAt, StringFormat='Updated: {0:g}'}"
                                                   FontSize="10"
                                                   Opacity="0.4"/>
                                    </StackPanel>
                                </Grid>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </DockPanel>
</Window>
